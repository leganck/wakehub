#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

NAME=wakehub
PROG=/usr/bin/wakehub-server
SYNC=/usr/libexec/wakehub-uci-sync

start_service() {
	config_load wakehub

	local enabled listen_port config_path
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0

	config_get listen_port main listen_port 8080
	config_get config_path main config_path /etc/wakehub/config.json

	[ -x "$SYNC" ] && "$SYNC" || true

	[ -x "$PROG" ] || {
		echo "$PROG not found" >&2
		return 1
	}

	mkdir -p "$(dirname "$config_path")"

	procd_open_instance
	procd_set_param command "$PROG" -config "$config_path" -listen ":${listen_port}"
	procd_set_param respawn "${respawn_threshold:-3600}" "${respawn_timeout:-5}" "${respawn_retry:-5}"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/wakehub
	procd_set_param file "$config_path"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger wakehub
}

reload_service() {
	stop
	start
}
