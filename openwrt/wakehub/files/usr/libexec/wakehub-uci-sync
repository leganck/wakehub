#!/bin/sh
# Sync UCI global settings into WakeHub config.json (preserve devices/groups/schedules).

. /lib/functions.sh 2>/dev/null || true

CONFIG_PATH=
LISTEN_PORT=
BEMFA_UID=
CLIENT_TOKEN=
WS_PATH=
BASIC_AUTH_ENABLE=
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
WEB_GLOBAL_MODE=

load_uci() {
	if [ -f /etc/config/wakehub ] && type config_load >/dev/null 2>&1; then
		config_load wakehub
		config_get CONFIG_PATH main config_path /etc/wakehub/config.json
		config_get LISTEN_PORT main listen_port 8080
		config_get BEMFA_UID main bemfa_uid ""
		config_get CLIENT_TOKEN main client_token ""
		config_get WS_PATH main ws_path /api/ws/client
		config_get_bool BASIC_AUTH_ENABLE main basic_auth_enable 1
		config_get BASIC_AUTH_USER main basic_auth_user admin
		config_get BASIC_AUTH_PASSWORD main basic_auth_password admin
		config_get WEB_GLOBAL_MODE main web_global_mode readonly
	else
		CONFIG_PATH="${CONFIG_PATH:-/etc/wakehub/config.json}"
		LISTEN_PORT="${LISTEN_PORT:-8080}"
		WS_PATH="${WS_PATH:-/api/ws/client}"
		BASIC_AUTH_ENABLE="${BASIC_AUTH_ENABLE:-1}"
		BASIC_AUTH_USER="${BASIC_AUTH_USER:-admin}"
		BASIC_AUTH_PASSWORD="${BASIC_AUTH_PASSWORD:-admin}"
		WEB_GLOBAL_MODE="${WEB_GLOBAL_MODE:-readonly}"
	fi

	[ -n "$CONFIG_PATH" ] || CONFIG_PATH=/etc/wakehub/config.json
	[ -n "$LISTEN_PORT" ] || LISTEN_PORT=8080
	[ -n "$WS_PATH" ] || WS_PATH=/api/ws/client
	[ -n "$BASIC_AUTH_USER" ] || BASIC_AUTH_USER=admin
	[ -n "$BASIC_AUTH_PASSWORD" ] || BASIC_AUTH_PASSWORD=admin
	case "$BASIC_AUTH_ENABLE" in
	1|on|true|yes|enabled) BASIC_AUTH_ENABLE=1 ;;
	*) BASIC_AUTH_ENABLE=0 ;;
	esac
	case "$WEB_GLOBAL_MODE" in
	writeback|WRITEBACK) WEB_GLOBAL_MODE=writeback ;;
	*) WEB_GLOBAL_MODE=readonly ;;
	esac
}

json_escape() {
	printf '%s' "$1" | sed \
		-e 's/\\/\\\\/g' \
		-e 's/"/\\"/g' \
		-e 's/	/\\t/g' \
		-e ':a;N;$!ba;s/\n/\\n/g' 2>/dev/null || printf '%s' "$1"
}

json_get() {
	# json_get path key default
	local cfg="$1" key="$2" def="$3" raw
	if [ -f "$cfg" ] && command -v jsonfilter >/dev/null 2>&1; then
		raw=$(jsonfilter -i "$cfg" -e "@.$key" 2>/dev/null) || raw=
		if [ -n "$raw" ]; then
			printf '%s' "$raw"
			return 0
		fi
	fi
	printf '%s' "$def"
}

write_config() {
	local devices="$1" groups="$2" schedules="$3"
	local listen bemfa token wspath user pass auth_json mode
	local notify_wh notify_wake notify_shut notify_probe notify_sched
	local dir tmp

	listen=$(json_escape ":${LISTEN_PORT}")
	bemfa=$(json_escape "$BEMFA_UID")
	token=$(json_escape "$CLIENT_TOKEN")
	wspath=$(json_escape "$WS_PATH")
	user=$(json_escape "$BASIC_AUTH_USER")
	pass=$(json_escape "$BASIC_AUTH_PASSWORD")
	mode=$(json_escape "$WEB_GLOBAL_MODE")
	if [ "$BASIC_AUTH_ENABLE" = "1" ]; then
		auth_json="true"
	else
		auth_json="false"
	fi

	notify_wh=$(json_escape "$(json_get "$CONFIG_PATH" 'settings.notifyWebhook' '')")
	notify_wake=$(json_get "$CONFIG_PATH" 'settings.notifyOnWake' 'false')
	notify_shut=$(json_get "$CONFIG_PATH" 'settings.notifyOnShutdown' 'false')
	notify_probe=$(json_get "$CONFIG_PATH" 'settings.notifyOnProbeChange' 'false')
	notify_sched=$(json_get "$CONFIG_PATH" 'settings.notifyOnSchedule' 'false')
	case "$notify_wake" in true|1) notify_wake=true ;; *) notify_wake=false ;; esac
	case "$notify_shut" in true|1) notify_shut=true ;; *) notify_shut=false ;; esac
	case "$notify_probe" in true|1) notify_probe=true ;; *) notify_probe=false ;; esac
	case "$notify_sched" in true|1) notify_sched=true ;; *) notify_sched=false ;; esac

	[ -n "$devices" ] || devices='[]'
	[ -n "$groups" ] || groups='[]'
	[ -n "$schedules" ] || schedules='[]'

	dir=$(dirname "$CONFIG_PATH")
	mkdir -p "$dir"
	tmp="${CONFIG_PATH}.tmp.$$"

	cat >"$tmp" <<EOF
{
  "version": 1,
  "settings": {
    "listen": "${listen}",
    "bemfaUID": "${bemfa}",
    "clientToken": "${token}",
    "wsPath": "${wspath}",
    "basicAuthEnable": ${auth_json},
    "basicAuthUser": "${user}",
    "basicAuthPassword": "${pass}",
    "globalManagedByLuci": true,
    "webGlobalMode": "${mode}",
    "notifyWebhook": "${notify_wh}",
    "notifyOnWake": ${notify_wake},
    "notifyOnShutdown": ${notify_shut},
    "notifyOnProbeChange": ${notify_probe},
    "notifyOnSchedule": ${notify_sched}
  },
  "devices": ${devices},
  "groups": ${groups},
  "schedules": ${schedules}
}
EOF
	mv "$tmp" "$CONFIG_PATH"
}

extract_array() {
	local cfg="$1" key="$2"
	local raw
	if [ -f "$cfg" ] && command -v jsonfilter >/dev/null 2>&1; then
		raw=$(jsonfilter -i "$cfg" -e "@.$key" 2>/dev/null) || raw=
		case "$raw" in
		\[*) printf '%s' "$raw"; return 0 ;;
		esac
	fi
	if [ -f "$cfg" ] && command -v jq >/dev/null 2>&1; then
		jq -c ".$key // []" "$cfg" 2>/dev/null && return 0
	fi
	printf '%s' '[]'
}

main() {
	load_uci

	devices='[]'
	groups='[]'
	schedules='[]'
	if [ -f "$CONFIG_PATH" ]; then
		devices=$(extract_array "$CONFIG_PATH" devices)
		groups=$(extract_array "$CONFIG_PATH" groups)
		schedules=$(extract_array "$CONFIG_PATH" schedules)
	fi

	write_config "$devices" "$groups" "$schedules"
}

main "$@"
