# syntax=docker/dockerfile:1
# Build from monorepo parent context: docker build -f wol/deploy/Dockerfile.context -t wakehub-server .   # run from parent of wol/
FROM golang:1.22-alpine AS build
WORKDIR /src
RUN apk add --no-cache git ca-certificates
COPY wol /src/wakehub
COPY bemfa-go /src/bemfa-go
WORKDIR /src/wakehub
RUN sed -i 's|=> ../bemfa-go|=> /src/bemfa-go|' go.mod \
 && go mod tidy \
 && CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/wakehub-server ./cmd/server

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=build /out/wakehub-server /app/wakehub-server
RUN mkdir -p /app/data
EXPOSE 8080
VOLUME ["/app/data"]
ENTRYPOINT ["/app/wakehub-server","-config","/app/data/config.json","-listen",":8080"]
