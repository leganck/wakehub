# syntax=docker/dockerfile:1
# Build from monorepo parent context: docker build -f deploy/Dockerfile.context -t wol-server ..
FROM golang:1.22-alpine AS build
WORKDIR /src
RUN apk add --no-cache git ca-certificates
COPY wol /src/wol
COPY bemfa-go /src/bemfa-go
WORKDIR /src/wol
RUN sed -i 's|=> ../bemfa-go|=> /src/bemfa-go|' go.mod \
 && go mod tidy \
 && CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/wol-server ./cmd/server

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=build /out/wol-server /app/wol-server
RUN mkdir -p /app/data
EXPOSE 8080
VOLUME ["/app/data"]
ENTRYPOINT ["/app/wol-server","-config","/app/data/config.json","-listen",":8080"]
